# ============================================================
# ARNIE / AgenticOS
# Git Ignore
# ============================================================

# ------------------------------------------------------------
# Python
# ------------------------------------------------------------

__pycache__/
*.py[cod]
*$py.class

.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# ------------------------------------------------------------
# Environment / Secrets
# ------------------------------------------------------------

.env
.env.*
!.env.example

*.pem
*.key
*.p12
*.pfx

# ------------------------------------------------------------
# Logs
# ------------------------------------------------------------

*.log
logs/

# ------------------------------------------------------------
# Runtime data
# ------------------------------------------------------------

data/*.db
data/*.sqlite
data/*.sqlite3

data/chroma/
data/vector/
data/cache/
data/tmp/
data/runtime/
data/reports/

# Phase 19: client CRM data lives at the project root, not under data/.
clients.json

# Phase 24: prospect research data lives at the project root.
prospects.json

# Phase 26: savings baseline data lives at the project root.
savings_baselines.json

# Phase 27: automation activity log data lives at the project root.
automation_runs.json

# ------------------------------------------------------------
# Generated / temporary files
# ------------------------------------------------------------

tmp/
temp/
cache/
output/
outputs/

*.tmp
*.temp

# ------------------------------------------------------------
# Audio / generated media
# ------------------------------------------------------------

*.wav
*.mp3
*.ogg
*.flac
*.m4a

# ------------------------------------------------------------
# Model files
# ------------------------------------------------------------

# Do NOT commit model weights.
#
# Keep the models directory itself in the project if useful,
# but ignore large model assets.

models/*.onnx
models/*.bin
models/*.safetensors
models/*.gguf
models/*.pt
models/*.pth
models/*.ckpt

# Kokoro / TTS model assets
models/**/kokoro-v1.0.onnx
models/**/voices-v1.0.bin

# ------------------------------------------------------------
# Local development artifacts
# ------------------------------------------------------------

.vscode/
.idea/

*.code-workspace

# ------------------------------------------------------------
# OS files
# ------------------------------------------------------------

.DS_Store
Thumbs.db
desktop.ini

# ------------------------------------------------------------
# Build / packaging
# ------------------------------------------------------------

build/
dist/
*.egg-info/

# ------------------------------------------------------------
# Generated reports / artifacts
# ------------------------------------------------------------

*.zip
*.tar
*.tar.gz

# ------------------------------------------------------------
# Local ARNIE runtime state
# ------------------------------------------------------------

runtime/
staging/
artifacts/

# ------------------------------------------------------------
# Chroma / Vector Database
# ------------------------------------------------------------

data/chroma_db/
# Tool scaffolding
.ijfw/
AGENTS.md
audit_sessions.json
reports/
reports/*.html
